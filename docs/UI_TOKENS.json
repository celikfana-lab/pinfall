  "sdl_guidance": {
    "cheap": [
      "solid rect fills (header, search pill, buttons, card placeholders)",
      "SDL2_ttf text blits with 2 fonts (regular + bold)",
      "rounded-rect clip: render to 16x16 corner masks or use 4 tiny corner alpha sprites; radius 16 for cards, 24 for pills",
      "1-2px dividers (#efefef) as thin filled rects",
      "dark scrim for detail view: SDL_SetRenderDrawBlendMode(SDL_BLENDMODE_BLEND) + fill rgba(0,0,0,0.6)",
      "hover overlay: flat 25% black wash over image + solid red Save pill (no shadow needed)"
    ],
    "expensive_skip_or_fake": [
      "backdrop blur / frosted glass -> flat scrim or solid color",
      "box shadows -> skip; cards are flat with rounded corners",
      "image crossfade/shimmer -> static #efefef placeholder rect",
      "vector logo -> draw red circle mark + bold text 'Pinterest' (or omit wordmark, keep P)"
    ],
    "performance": [
      "one SDL_Texture per loaded thumbnail, capped at 236px wide (max ~64MB cache)",
      "lazy upload: only create textures for cards in/near the viewport, evict far-off ones",
      "prefetch next page when scrollY > contentH - 2*viewportH",
      "cache scaled textures at card width (221/267/234) to avoid per-frame scaling",
      "target 60fps: batch fills, no per-pixel effects"
    ]
  }
}